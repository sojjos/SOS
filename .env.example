# ===========================================
# Configuration SOS - Fichier d'exemple
# ===========================================
# Copiez ce fichier vers .env et modifiez les valeurs

# Environnement
NODE_ENV=production

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=3001
DB_PORT=5432

# Base de données PostgreSQL
DB_NAME=sos_db
DB_USER=sos_user
DB_PASSWORD=votre_mot_de_passe_securise

# JWT - Secrets (générez des chaînes aléatoires sécurisées)
# Utilisez: openssl rand -base64 64
JWT_SECRET=changez_cette_valeur_avec_une_chaine_aleatoire_securisee
JWT_REFRESH_SECRET=changez_cette_valeur_aussi_avec_une_autre_chaine

# Compte administrateur par défaut
DEFAULT_ADMIN_EMAIL=admin@votredomaine.com
DEFAULT_ADMIN_PASSWORD=ChangezCeMotDePasse!

# URL Frontend (pour les liens dans les emails)
FRONTEND_URL=https://sos.votredomaine.com

# Configuration SMTP pour les emails
SMTP_HOST=smtp.votredomaine.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@votredomaine.com
SMTP_PASS=votre_mot_de_passe_smtp
EMAIL_FROM=noreply@votredomaine.com
EMAIL_FROM_NAME=SOS - Short Operational Summary

# Sécurité
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
