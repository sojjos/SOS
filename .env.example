# ===========================================
# Configuration SOS - Fichier d'exemple
# Short Operational Summary
# ===========================================
# Copiez ce fichier vers .env et modifiez les valeurs
# Ou utilisez: ./install.sh pour une configuration automatique

# ===========================================
# ENVIRONNEMENT
# ===========================================
NODE_ENV=production

# Domaine (pour production)
DOMAIN=localhost

# ===========================================
# PORTS
# ===========================================
FRONTEND_PORT=3000
BACKEND_PORT=3001
DB_PORT=5432

# ===========================================
# BASE DE DONNÉES POSTGRESQL
# ===========================================
DB_HOST=postgres
DB_NAME=sos_db
DB_USER=sos_user
DB_PASSWORD=votre_mot_de_passe_securise

# ===========================================
# JWT - AUTHENTIFICATION
# ===========================================
# Générez des secrets sécurisés avec: openssl rand -base64 64

# JWT pour les utilisateurs standard
JWT_SECRET=changez_cette_valeur_avec_une_chaine_aleatoire_securisee
JWT_REFRESH_SECRET=changez_cette_valeur_aussi_avec_une_autre_chaine
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# JWT pour les administrateurs plateforme (SaaS)
PLATFORM_JWT_SECRET=encore_une_autre_chaine_aleatoire_pour_platform_admins

# ===========================================
# COMPTES ADMINISTRATEURS PAR DÉFAUT
# ===========================================

# Admin Entreprise (accès à une entreprise)
DEFAULT_ADMIN_EMAIL=admin@votredomaine.com
DEFAULT_ADMIN_PASSWORD=ChangezCeMotDePasse!

# Admin Plateforme (accès SaaS global)
DEFAULT_PLATFORM_ADMIN_EMAIL=platform@votredomaine.com
DEFAULT_PLATFORM_ADMIN_PASSWORD=ChangezCeMotDePasseAussi!

# ===========================================
# URLs
# ===========================================
# URL du frontend (pour les liens dans les emails)
FRONTEND_URL=https://sos.votredomaine.com

# URL de l'API (pour le frontend)
VITE_API_URL=/api

# ===========================================
# SSL / HTTPS
# ===========================================
ENABLE_SSL=false
SSL_EMAIL=admin@votredomaine.com

# ===========================================
# EMAIL / SMTP
# ===========================================
SMTP_HOST=smtp.votredomaine.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@votredomaine.com
SMTP_PASS=votre_mot_de_passe_smtp
EMAIL_FROM=noreply@votredomaine.com
EMAIL_FROM_NAME=SOS - Short Operational Summary

# ===========================================
# SÉCURITÉ
# ===========================================
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# WEBSOCKET
# ===========================================
WS_ENABLED=true
WS_HEARTBEAT_INTERVAL=30000

# ===========================================
# BACKUP
# ===========================================
BACKUP_DIR=./backups
RETENTION_DAYS=30

# ===========================================
# LOGS
# ===========================================
LOG_LEVEL=info
LOG_FORMAT=combined
