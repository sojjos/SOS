# ====================================
# SOS - Configuration Serveur
# ====================================

# Application
NODE_ENV=production
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sos_db
DB_USER=sos_user
DB_PASSWORD=your_secure_password_here

# JWT (Authentification)
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_here_min_32_chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@sos.example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_NAME=SOS - Notifications automatiques
SMTP_FROM_EMAIL=noreply@sos.example.com

# Sécurité
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logs
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Admin par défaut (premier lancement uniquement)
DEFAULT_ADMIN_EMAIL=admin@sos.local
DEFAULT_ADMIN_PASSWORD=ChangeMeOnFirstLogin!
